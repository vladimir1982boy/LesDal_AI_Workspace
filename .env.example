# Copy this file to secrets/.env.local and fill in real values locally.
# Keep this template free of real secrets.
# Save secrets/.env.local as UTF-8 without BOM.

TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHANNEL_ID=@your_channel_or_numeric_id

OPENAI_API_KEY=your_openai_api_key
GEMINI_API_KEY=your_gemini_api_key

MAX_BOT_TOKEN=your_max_bot_token
MAX_CHANNEL_ID=your_max_channel_id

VK_API_KEY=your_vk_user_access_token
VK_GROUP_ID=123456789
VK_LONGPOLL_TOKEN=your_vk_longpoll_token_if_needed

AI_SALES_ADMIN_ID=123456789
AI_SALES_ADMIN_CHAT_ID=
AI_SALES_MANAGER_NAME=Vladimir
AI_SALES_GEMINI_MODEL=gemini-2.5-flash

GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id
GOOGLE_SHEETS_CREDENTIALS_PATH=secrets/google-service-account.json
GOOGLE_SHEETS_LEADS_SHEET=Sheet1

AI_SALES_DASHBOARD_HOST=127.0.0.1
AI_SALES_DASHBOARD_PORT=8787
AI_SALES_DASHBOARD_TOKEN=your_dashboard_token
